# Copy to .env if you want to change a default. Every setting is optional for local use.
# Online (Hugging Face Space), set these in the Space's settings instead -- see docs/DEPLOY.md.

# Database. Default: a SQLite file at data/gestureflow.db, nothing to install.
# PostgreSQL (local, Neon, Supabase): paste the URL as given, e.g.
#   postgresql://USER:PASSWORD@localhost:5432/gestureflow
# GESTUREFLOW_DATABASE_URL=

# Signs login tokens. If unset, a random one is made each time the server starts, which
# logs everyone out on restart. Required when GESTUREFLOW_ENV=production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
GESTUREFLOW_JWT_SECRET=
GESTUREFLOW_ENV=development

# How long a login lasts.
GESTUREFLOW_TOKEN_HOURS=24

# Browser origins allowed to call the API (JSON list).
GESTUREFLOW_CORS_ORIGINS=["http://localhost:3000"]

# Sentence generation: ollama (on this PC, no key) | groq (hosted, needs a key) | none
GESTUREFLOW_SENTENCE_PROVIDER=ollama
GESTUREFLOW_SENTENCES_PER_HOUR=20
GESTUREFLOW_OLLAMA_MODEL=gemma3:4b
# GESTUREFLOW_OLLAMA_URL=
GESTUREFLOW_GROQ_MODEL=llama-3.1-8b-instant
# GESTUREFLOW_GROQ_API_KEY=gsk_...

# Frontend: where the browser finds the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
